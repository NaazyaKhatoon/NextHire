# ===================================================
# NextHire Environment Variables Reference Guide
# ===================================================

# Frontend Environment Variables (Vercel Client)
VITE_API_BASE_URL=/api
VITE_APP_NAME=NextHire

# Backend Environment Variables (Vercel Serverless / Render / Railway)
PORT=5000
NODE_ENV=production
JWT_SECRET=nexthire_production_secure_jwt_secret_key_2026_x99

# Neon Serverless PostgreSQL Database Connection URI
# Obtain from your Neon Console (https://console.neon.tech):
DATABASE_URL=postgresql://<user>:<password>@ep-cool-fog-123456.us-east-2.aws.neon.tech/nexthire?sslmode=require

# AI Microservice URL (FastAPI):
AI_SERVICE_URL=http://127.0.0.1:8000

# Set DEMO_MODE=true for offline fallback, or false for production Neon persistence:
DEMO_MODE=false
